<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsRdpApp.ViewModels"
             x:Class="WindowsRdpApp.Views.QuickConnectView"
             x:DataType="vm:QuickConnectViewModel"
             x:CompileBindings="True">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="16">
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Quick Connect" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Establish a direct Remote Desktop Protocol (RDP) session with custom host credentials."
                           Foreground="#9aa0a6" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator Height="1" Background="#2d2d2d" Margin="0,4"/>

            <!-- Connection Form Cards -->
            <Border Background="#1e1e1e" BorderBrush="#2d2d2d" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="120, *">
                    <!-- Host -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IP:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host, Mode=TwoWay}" PlaceholderText="e.g. 192.168.1.100 or rdp.domain.com" Margin="0,4"/>

                    <!-- Port -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, Mode=TwoWay}" PlaceholderText="3389" Margin="0,4"/>

                    <!-- Username -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" PlaceholderText="Administrator / User" Margin="0,4"/>

                    <!-- Password -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" PlaceholderText="Password (optional)" Margin="0,4"/>

                    <!-- Domain -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Domain:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Domain, Mode=TwoWay}" PlaceholderText="DOMAIN or local" Margin="0,4"/>

                    <!-- Profile Name -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Profile Name:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProfileName, Mode=TwoWay}" PlaceholderText="Friendly label for session" Margin="0,4"/>

                    <!-- Actions -->
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button Name="btnQuickConnect"
                                AutomationProperties.AutomationId="btnQuickConnect"
                                Command="{Binding ConnectCommand}"
                                Classes="accent"
                                Width="140" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource PlugIcon}" Width="14" Height="14"/>
                                <TextBlock Text="Quick Connect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearCommand}" Width="100" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <Border Background="#252526" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource MonitorIcon}" Width="16" Height="16" Foreground="#8ab4f8"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#cccccc" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
