<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rdp="clr-namespace:Avalonia.Diagnostics.Cdp.Rdp"
             x:Class="Avalonia.Diagnostics.Cdp.Rdp.RdpView"
             x:CompileBindings="True"
             x:DataType="rdp:RdpView">
    <Grid RowDefinitions="Auto,*">
        <!-- Control Bar Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Host:" VerticalAlignment="Center" Foreground="#cccccc"/>
                <TextBox Name="txtHost" AutomationProperties.AutomationId="txtHost" Width="130"
                         Text="{Binding Host, RelativeSource={RelativeSource AncestorType=rdp:RdpView}, Mode=TwoWay}"/>

                <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="#cccccc"/>
                <TextBox Name="txtPort" AutomationProperties.AutomationId="txtPort" Width="60"
                         Text="{Binding Port, RelativeSource={RelativeSource AncestorType=rdp:RdpView}, Mode=TwoWay}"/>

                <TextBlock Text="User:" VerticalAlignment="Center" Foreground="#cccccc"/>
                <TextBox Name="txtUsername" AutomationProperties.AutomationId="txtUsername" Width="100"
                         Text="{Binding Username, RelativeSource={RelativeSource AncestorType=rdp:RdpView}, Mode=TwoWay}"/>

                <TextBlock Text="Pass:" VerticalAlignment="Center" Foreground="#cccccc"/>
                <TextBox Name="txtPassword" AutomationProperties.AutomationId="txtPassword" Width="100" PasswordChar="*"
                         Text="{Binding Password, RelativeSource={RelativeSource AncestorType=rdp:RdpView}, Mode=TwoWay}"/>

                <Button Name="btnConnect" AutomationProperties.AutomationId="btnConnect" Content="Connect"
                        Command="{Binding ConnectCommand, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"/>

                <Button Name="btnDisconnect" AutomationProperties.AutomationId="btnDisconnect" Content="Disconnect"
                        Command="{Binding DisconnectCommand, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"/>
            </StackPanel>
        </Border>

        <!-- Main RDP Canvas Viewport -->
        <rdp:RdpControl Name="rdpControl" AutomationProperties.AutomationId="rdpControl"
                        Grid.Row="1"
                        Host="{Binding Host, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        Port="{Binding Port, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        Username="{Binding Username, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        Password="{Binding Password, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        Domain="{Binding Domain, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        IsConnected="{Binding IsConnected, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        ConnectCommand="{Binding ConnectCommand, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        DisconnectCommand="{Binding DisconnectCommand, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"
                        Session="{Binding Session, RelativeSource={RelativeSource AncestorType=rdp:RdpView}}"/>
    </Grid>
</UserControl>
