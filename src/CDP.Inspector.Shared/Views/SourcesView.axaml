<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:map="using:XamlPlayground.Editor.Minimap"
             xmlns:vm="clr-namespace:CdpInspectorApp.ViewModels"
             xmlns:tree="clr-namespace:Avalonia.Controls.DataGridHierarchical;assembly=Avalonia.Controls.DataGrid"
             xmlns:models="clr-namespace:CdpInspectorApp.Models;assembly=CDP.Inspector.Shared"
             xmlns:views="clr-namespace:CdpInspectorApp.Views;assembly=CDP.Inspector.Shared"
             x:Class="CdpInspectorApp.Views.SourcesView"
             x:DataType="vm:MainWindowViewModel"
             xmlns:splits="clr-namespace:CDP.Editor.Splits.Controls;assembly=CDP.Editor.Splits"
             xmlns:md="using:CDP.Markdown.Editor"
             xmlns:doc="using:CDP.Document.Editor"
             x:CompileBindings="True">
    <Grid RowDefinitions="*" Margin="4" Background="{DynamicResource Brush.Sources.Editor}">
        <splits:SuperSplit Name="SplitControl"
                            Grid.Row="0"
                            Root="{Binding Sources.LayoutRoot}"
                            SelectedNode="{Binding Sources.SelectedPane, Mode=TwoWay}"
                            DockGroup="Sources"
                            ConstrainDockingToRoot="True"/>
        
        <Grid Name="HiddenPanel" IsVisible="False">
            <Grid Name="pnlSourcesFiles" RowDefinitions="28, *, 28, 120" Margin="6,4" Background="{DynamicResource Brush.Sources.Panel}">
                    <TextBlock Text="Explorer" Classes="sources-pane-title" Margin="4,0"/>
                    <DataGrid Name="treeWorkspaceFiles"
                                 HierarchicalModel="{Binding Sources.HierarchicalWorkspaceFiles}"
                                 SelectedItem="{Binding Sources.SelectedFileNode, Mode=TwoWay}"
                                 HierarchicalRowsEnabled="True"
                                 GridLinesVisibility="None"
                                 HeadersVisibility="None"
                                 Background="Transparent" BorderThickness="0"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="False"
                                 Grid.Row="1">
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridHierarchicalColumn Width="*">
                                <DataGridHierarchicalColumn.CellTemplate>
                                    <DataTemplate x:DataType="tree:HierarchicalNode">
                                        <TextBlock Text="{Binding ((models:WorkspaceFileNode)Item).Name}"/>
                                    </DataTemplate>
                                </DataGridHierarchicalColumn.CellTemplate>
                            </DataGridHierarchicalColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock Text="Outline" Classes="sources-pane-title" Grid.Row="2" Margin="4,0"/>
                    <TreeView Name="treeOutline" Grid.Row="3" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="views:JavaScriptOutlineItem" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            <Grid Name="pnlSourcesRuntimeScripts" RowDefinitions="28, Auto, *" Margin="6,4" Background="{DynamicResource Brush.Sources.Panel}">
                <TextBlock Text="Loaded Scripts" Classes="sources-pane-title" Margin="4,0"/>
                <Border Grid.Row="1" Classes="sources-section" Padding="6,4" Margin="0,0,0,3">
                    <TextBlock Name="txtV8DebuggerStatus" Text="{Binding Sources.DebuggerStatusText}" Classes="sources-meta" TextWrapping="Wrap"/>
                </Border>
                <ListBox Name="lstRuntimeScripts" Grid.Row="2"
                         ItemsSource="{Binding Sources.RuntimeScripts}"
                         SelectedItem="{Binding Sources.SelectedRuntimeScript, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:V8ScriptModel">
                            <Grid Margin="1,2" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Text="{Binding LanguageBadge}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Sources.Accent}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource Brush.Sources.Text}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DetailDisplay}" Classes="sources-meta" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Name="pnlSourcesSearch" RowDefinitions="28, Auto, Auto, *" Margin="6,4" Background="{DynamicResource Brush.Sources.Panel}">
                    <TextBlock Text="Search" Classes="sources-pane-title" Margin="4,0"/>

                    <!-- Query Input and Search button -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <TextBox Name="txtSourcesSearch"
                                 Text="{Binding Sources.SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search files..."
                                 Height="28"
                                 VerticalContentAlignment="Center"/>
                        <Button Name="btnSearchWorkspace"
                                Command="{Binding Sources.SearchCommand}"
                                Grid.Column="1"
                                Content="Search"
                                Classes="sources-compact"
                                Margin="5,0,0,0"
                                Padding="10,0"
                                Height="28"/>
                    </Grid>

                    <!-- Case sensitive checkbox -->
                    <CheckBox Grid.Row="2"
                              IsChecked="{Binding Sources.SearchCaseSensitive, Mode=TwoWay}"
                              Margin="0,0,0,8">
                         <TextBlock Text="Case sensitive" FontSize="12" VerticalAlignment="Center"/>
                    </CheckBox>

                    <!-- Search Results DataGrid -->
                    <DataGrid Grid.Row="3"
                              Name="dgSearchResults"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Sources.SearchResults}"
                              x:DataType="models:SearchResultModel"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              CanUserResizeColumns="True"
                              DoubleTapped="OnSearchResultDoubleTapped">
                        <DataGrid.Columns>
                            <!-- File Column -->
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding Path}"
                                                Width="120"
                                                Foreground="#8ab4f8"
                                                FontSize="11"/>
                            <!-- Line Column -->
                            <DataGridTextColumn Header="Line"
                                                Binding="{Binding LineNumber}"
                                                Width="50"
                                                Foreground="#9aa0a6"
                                                FontSize="11"/>
                            <!-- Preview Column -->
                            <DataGridTextColumn Header="Content"
                                                Binding="{Binding LineContent}"
                                                Width="*"
                                                Foreground="#e8eaed"
                                                FontSize="11"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            <!-- Code Viewer -->
            <Grid Name="pnlCodeViewer" RowDefinitions="34, *" Margin="0" Background="{DynamicResource Brush.Sources.Editor}">
                <Grid ColumnDefinitions="Auto,*,Auto" Background="{DynamicResource Brush.Sources.Panel}" Margin="8,0">
                    <PathIcon Data="{StaticResource CodeIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Name="lblSourceFileName" Grid.Column="1" Text="{Binding Sources.SelectedFileName}" Classes="sources-pane-title" Margin="7,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Name="txtLiveEditPreview" Text="{Binding Sources.LiveEditPreview}" Classes="sources-meta"
                                   MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Sources.LiveEditPreview}"/>
                        <TextBlock Text="{Binding Sources.LiveEditStatusGlyph}" Classes="sources-meta"
                                   Classes.live-edit-info="{Binding Sources.IsLiveEditInfo}"
                                   Classes.live-edit-success="{Binding Sources.IsLiveEditSuccess}"
                                   Classes.live-edit-warning="{Binding Sources.IsLiveEditWarning}"
                                   Classes.live-edit-error="{Binding Sources.IsLiveEditError}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Name="txtLiveEditStatus" Text="{Binding Sources.LiveEditStatus}" Classes="sources-meta"
                                   Classes.live-edit-info="{Binding Sources.IsLiveEditInfo}"
                                   Classes.live-edit-success="{Binding Sources.IsLiveEditSuccess}"
                                   Classes.live-edit-warning="{Binding Sources.IsLiveEditWarning}"
                                   Classes.live-edit-error="{Binding Sources.IsLiveEditError}"
                                   MaxWidth="210" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"
                                   ToolTip.Tip="{Binding Sources.LiveEditStatus}"/>
                        <Button Name="btnSourceQuickOpen" Classes="debug-action" Height="24" Width="27"
                                ToolTip.Tip="Quick Open (Ctrl+P)" AutomationProperties.Name="Quick open source file">
                            <PathIcon Data="{StaticResource SearchIcon}" Width="12" Height="12"/>
                        </Button>
                        <TextBlock Name="txtLanguageStatus" Classes="sources-meta" MaxWidth="230" IsVisible="{Binding Sources.IsJavaScriptFile}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="Ctrl+P files · Ctrl+Shift+P commands · Ctrl+T workspace symbols · Ctrl+Shift+O document symbols"/>
                        <Button Name="btnSourceSymbols" Classes="sources-compact" Content="Outline" Height="24" Padding="7,0" IsVisible="{Binding Sources.IsJavaScriptFile}"
                                ToolTip.Tip="Document symbols (Ctrl+Shift+O)" AutomationProperties.Name="Show document symbols"/>
                        <Button Name="btnSourceReferences" Classes="sources-compact" Content="Refs" Height="24" Padding="7,0" IsVisible="{Binding Sources.IsJavaScriptFile}"
                                ToolTip.Tip="Find all references (Shift+F12)" AutomationProperties.Name="Find all references"/>
                        <Button Name="btnFormatSource" Classes="sources-compact" Content="Format" Height="24" Padding="7,0" IsVisible="{Binding Sources.IsJavaScriptFile}"
                                ToolTip.Tip="Format document (Shift+Alt+F)" AutomationProperties.Name="Format source document"/>
                        <ToggleButton Name="btnToggleMarkdownMode"
                                      IsVisible="{Binding Sources.IsMarkdownFile}"
                                      IsChecked="{Binding Sources.IsMarkdownPreviewMode, Mode=TwoWay}"
                                      Height="26" Padding="7,0" VerticalAlignment="Center" ToolTip.Tip="Toggle Preview / Source Mode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel>
                                    <PathIcon Data="{StaticResource EyeIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsSourceEditorVisible}"/>
                                    <PathIcon Data="{StaticResource CodeIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsMarkdownPreviewMode}"/>
                                </Panel>
                                <TextBlock Text="Preview" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Name="btnToggleDocumentMode"
                                      IsVisible="{Binding Sources.IsDocumentFile}"
                                      IsChecked="{Binding Sources.IsDocumentPreviewMode, Mode=TwoWay}"
                                      Height="26" Padding="7,0" VerticalAlignment="Center" ToolTip.Tip="Toggle Rendered / Raw Mode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel>
                                    <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsDocumentPreviewMode}"/>
                                    <PathIcon Data="{StaticResource CodeIcon}" Width="12" Height="12" IsVisible="{Binding !Sources.IsDocumentPreviewMode}"/>
                                </Panel>
                                <TextBlock Text="Rendered" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Name="btnSaveFile" Classes="debug-action" IsEnabled="{Binding Sources.CanEditCurrentSource}" ToolTip.Tip="Save file or apply V8 live edit (Ctrl+S)" AutomationProperties.Name="Save source or apply live edit">
                            <PathIcon Data="{StaticResource SaveIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button Name="btnThemeSelector" Classes="debug-action" ToolTip.Tip="Toggle editor theme" AutomationProperties.Name="Toggle editor theme">
                            <PathIcon Data="{StaticResource SettingsIcon}" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <map:MinimapTextEditor Name="txtSourceContent"
                                           IsVisible="{Binding Sources.IsSourceEditorVisible}"
                                           FontFamily="Consolas,Monaco,Courier New,monospace" FontSize="12" Foreground="{DynamicResource Brush.Sources.Text}" Background="{DynamicResource Brush.Sources.Editor}" BorderThickness="0" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                           ToolTip.Tip="F9 breakpoint · F5 continue · F6 pause · F10 step over · Ctrl+F10 run to cursor · F11 step into · Shift+F11 step out · Ctrl+Shift+E evaluate selection · Ctrl+S save/live edit"/>
                    <Border Name="pnlSourcePalette" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                            MaxWidth="680" Margin="32,12" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource Brush.Sources.Panel}" BorderBrush="{DynamicResource Brush.Sources.Accent}"
                            BoxShadow="0 8 24 2 #80000000" ZIndex="30">
                        <Grid RowDefinitions="Auto,Auto,240,Auto">
                            <Grid Margin="10,7,10,3" ColumnDefinitions="*,Auto">
                                <TextBlock Name="txtSourcePaletteTitle" Classes="sources-pane-title" VerticalAlignment="Center"/>
                                <TextBlock Name="txtSourcePaletteCount" Grid.Column="1" Classes="sources-meta" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox Name="txtSourcePaletteQuery" Grid.Row="1" Margin="8,3,8,6" Height="31"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="Source navigation query"/>
                            <ListBox Name="lstSourcePalette" Grid.Row="2" Margin="4,0" Background="Transparent" ClipToBounds="True"
                                     BorderThickness="0" AutomationProperties.Name="Source navigation results">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="views:SourcesPaletteItem">
                                        <Grid Margin="5,3" ColumnDefinitions="50,*,Auto" ColumnSpacing="7">
                                            <Border Background="{DynamicResource Brush.Sources.Editor}" CornerRadius="3"
                                                    Padding="4,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Sources.Accent}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Classes="sources-meta"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="sources-meta"
                                                       VerticalAlignment="Center" Margin="8,0,3,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Background="{DynamicResource Brush.Sources.Panel}">
                                <Grid Margin="10,5,10,7" ColumnDefinitions="*,Auto">
                                    <TextBlock Name="txtSourcePaletteHint" Classes="sources-meta"
                                               Text="↑↓ navigate · Enter open · Esc close"/>
                                    <TextBlock Grid.Column="1" Classes="sources-meta"
                                               Text="Ctrl+P files · Ctrl+Shift+P commands"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Name="pnlSourceRename" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,18,0" Padding="8" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource Brush.Sources.Panel}" BorderBrush="{DynamicResource Brush.Sources.Accent}"
                            ZIndex="20">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="220,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                            <TextBlock Name="txtRenameLabel" Grid.ColumnSpan="3" Text="Rename symbol" Classes="sources-meta"/>
                            <TextBox Name="txtRenameSource" Grid.Row="1" Height="27" VerticalContentAlignment="Center"
                                     PlaceholderText="New symbol name" AutomationProperties.Name="New symbol name"/>
                            <Button Name="btnApplySourceRename" Grid.Row="1" Grid.Column="1" Content="Rename" Classes="sources-compact" Height="27"/>
                            <Button Name="btnCancelSourceRename" Grid.Row="1" Grid.Column="2" Content="Cancel" Classes="sources-compact" Height="27"/>
                        </Grid>
                    </Border>
                    <ScrollViewer IsVisible="{Binding Sources.IsMarkdownPreviewMode}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <md:MarkdownEditor Name="mdVisualEditor"
                                           Text="{Binding Sources.SelectedFileContent, Mode=TwoWay}"
                                           IsReadOnly="{Binding !Sources.IsFileSelected}"
                                           IsDarkTheme="True"
                                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                    <ScrollViewer IsVisible="{Binding Sources.IsDocumentPreviewMode}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <doc:DocumentEditor Name="docVisualEditor"
                                            FilePath="{Binding Sources.LocalPreviewFilePath}"
                                            IsReadOnly="True"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- Right Debugger Panel -->
            <Border Name="pnlDebugger" BorderBrush="{DynamicResource Brush.Sources.Border}" BorderThickness="1,0,0,0" Background="{DynamicResource Brush.Sources.Panel}" Padding="0">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">
                    <Border Grid.Row="0" Classes="sources-pane" Padding="8,5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <TextBlock Text="●" Foreground="{DynamicResource Brush.Sources.Success}" FontSize="10" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Run and Debug" Classes="sources-pane-title"/>
                            <TextBlock Text="{Binding Sources.DebuggerStatusText}" Classes="sources-meta"/>
                        </StackPanel>
                        <ComboBox Name="cmbPauseOnExceptions" Grid.Column="2" Width="88" Height="24" FontSize="10"
                                  ItemsSource="{Binding Sources.PauseOnExceptionsStates}"
                                  SelectedItem="{Binding Sources.PauseOnExceptionsState, Mode=TwoWay}"
                                  ToolTip.Tip="Pause on exceptions"/>
                    </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="sources-pane" Padding="6,3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Name="btnDebuggerResume" Classes="debug-action" Command="{Binding Sources.ResumeCommand}" ToolTip.Tip="Continue (F5)" AutomationProperties.Name="Continue debugging">
                            <PathIcon Data="{StaticResource PlayIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Success}"/>
                        </Button>
                        <Button Name="btnDebuggerRunToCursor" Classes="debug-action" ToolTip.Tip="Run to cursor (Ctrl+F10)" AutomationProperties.Name="Run to cursor">
                            <PathIcon Data="{StaticResource ArrowRightIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Accent}"/>
                        </Button>
                        <Button Name="btnDebuggerPause" Classes="debug-action" Command="{Binding Sources.PauseCommand}" ToolTip.Tip="Pause (F6)" AutomationProperties.Name="Pause debugging">
                            <PathIcon Data="{StaticResource PauseIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Paused}"/>
                        </Button>
                        <Button Name="btnDebuggerStepOver" Classes="debug-action" Command="{Binding Sources.StepOverCommand}" ToolTip.Tip="Step over (F10)" AutomationProperties.Name="Step over">
                            <PathIcon Data="{StaticResource ArrowStepOverIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Accent}"/>
                        </Button>
                        <Button Name="btnDebuggerStepInto" Classes="debug-action" Command="{Binding Sources.StepIntoCommand}" ToolTip.Tip="Step into (F11)" AutomationProperties.Name="Step into">
                            <PathIcon Data="{StaticResource ArrowStepInIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Text}"/>
                        </Button>
                        <Button Name="btnDebuggerStepOut" Classes="debug-action" Command="{Binding Sources.StepOutCommand}" ToolTip.Tip="Step out (Shift+F11)" AutomationProperties.Name="Step out">
                            <PathIcon Data="{StaticResource ArrowStepOutIcon}" Width="13" Height="13" Foreground="{DynamicResource Brush.Sources.Text}"/>
                        </Button>
                        <Button Name="btnDebuggerRestartFrame" Classes="debug-action" Command="{Binding Sources.RestartFrameCommand}" ToolTip.Tip="Restart selected frame" AutomationProperties.Name="Restart selected frame" Content="↻" FontSize="16" Foreground="{DynamicResource Brush.Sources.Accent}"/>
                        <ToggleButton Name="tglDebuggerSkipAllPauses" Classes="debug-action" IsChecked="{Binding Sources.SkipAllPauses, Mode=TwoWay}"
                                      ToolTip.Tip="Skip all pauses: breakpoints, exceptions, and debugger statements"
                                      AutomationProperties.Name="Skip all debugger pauses" Content="⊘" FontSize="15"/>
                    </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="6,5">
                        <TextBox Name="txtDebuggerExpression" Text="{Binding Sources.DebuggerEvaluationExpression, Mode=TwoWay}"
                                 PlaceholderText="Debug console expression" FontSize="11" Height="26"/>
                        <Button Name="btnDebuggerEvaluate" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.EvaluateOnCallFrameCommand}" Content="Run" Margin="4,0,0,0"/>
                        <Button Name="btnDebuggerSetReturnValue" Classes="sources-compact" Grid.Column="2" Command="{Binding Sources.SetReturnValueCommand}"
                                Content="Set return" Margin="4,0,0,0" ToolTip.Tip="Change the top frame return value when paused at a function return"
                                AutomationProperties.Name="Set return value"/>
                    </Grid>

                    <Border Grid.Row="3" Classes="sources-section" Padding="7,3">
                        <TextBlock Text="{Binding Sources.DebuggerEvaluationResult}" FontFamily="Consolas,Monaco,Courier New,monospace" FontSize="11" Foreground="{DynamicResource Brush.Sources.Accent}" TextWrapping="Wrap"/>
                    </Border>

                    <splits:SuperSplit Name="DebuggerSplitControl"
                                       Grid.Row="4"
                                       Margin="4,2,4,4"
                                       Root="{Binding Sources.DebuggerLayoutRoot}"
                                       SelectedNode="{Binding Sources.SelectedDebuggerPane, Mode=TwoWay}"
                                       DockGroup="SourcesDebugger"
                                       ConstrainDockingToRoot="True"/>
                </Grid>
            </Border>

            <Border Name="pnlDebuggerWatch" Classes="sources-section" Padding="5">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0,0,4">
                        <TextBlock Text="Expressions" Classes="sources-meta" VerticalAlignment="Center"/>
                        <Button Name="btnRefreshWatches" Classes="debug-action" Grid.Column="1" Command="{Binding Sources.RefreshWatchExpressionsCommand}" Content="↻" FontSize="14" ToolTip.Tip="Refresh watches" AutomationProperties.Name="Refresh watches"/>
                        <Button Name="btnRemoveWatch" Classes="debug-action" Grid.Column="2" Command="{Binding Sources.RemoveWatchExpressionCommand}" Content="×" FontSize="15" ToolTip.Tip="Remove selected watch" AutomationProperties.Name="Remove selected watch"/>
                    </Grid>
                    <ListBox Name="lstDebuggerWatches" Grid.Row="1" ItemsSource="{Binding Sources.WatchExpressions}" SelectedItem="{Binding Sources.SelectedWatchExpression, Mode=TwoWay}" FontSize="11" Margin="0,0,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:V8WatchExpressionModel">
                                <Grid ColumnDefinitions="2*,3*">
                                    <TextBlock Text="{Binding Expression}" Foreground="{DynamicResource Brush.Sources.Accent}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{DynamicResource Brush.Sources.Text}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <TextBox Name="txtNewWatchExpression" Text="{Binding Sources.NewWatchExpression, Mode=TwoWay}" PlaceholderText="Add expression" FontSize="11" Height="25"/>
                        <Button Name="btnAddWatchExpression" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.AddWatchExpressionCommand}" Content="Add" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Name="pnlDebuggerCallStack" Classes="sources-section" Padding="4">
                <ListBox Name="lstDebuggerCallFrames" ItemsSource="{Binding Sources.CallFrames}" SelectedItem="{Binding Sources.SelectedCallFrame, Mode=TwoWay}" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:V8CallFrameModel">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Name="pnlDebuggerVariables" Classes="sources-section" Padding="4">
                <Grid RowDefinitions="*,Auto">
                    <TreeView Name="treeDebuggerScopes"
                              ItemsSource="{Binding Sources.ScopeVariables}"
                              SelectedItem="{Binding Sources.SelectedScopeVariable, Mode=TwoWay}"
                              Background="Transparent"
                              BorderBrush="{DynamicResource Brush.Sources.Border}"
                              BorderThickness="1" FontSize="11" Margin="0,0,0,4">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate x:DataType="models:V8ScopeVariableModel" ItemsSource="{Binding Children}">
                                <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="5" Margin="2,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.Sources.Accent}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Foreground="{DynamicResource Brush.Sources.Text}"
                                               FontFamily="Consolas,Monaco,Courier New,monospace"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeDisplay}"
                                               Classes="sources-meta" FontSize="9"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBox Name="txtNewVariableValue" Text="{Binding Sources.NewVariableValueExpression, Mode=TwoWay}" PlaceholderText="Set selected variable" FontSize="11" Height="25"/>
                        <Button Name="btnSetVariableValue" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.SetVariableValueCommand}" Content="Set" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Name="pnlDebuggerBreakpoints" Classes="sources-section" Padding="5">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <CheckBox Name="chkBreakpointsActive" Content="Breakpoints active" IsChecked="{Binding Sources.AreBreakpointsActive, Mode=TwoWay}" ToolTip.Tip="Globally activate or deactivate all breakpoints" FontSize="10" Margin="1,0,0,4"/>
                    <ListBox Name="lstV8Breakpoints" Grid.Row="1" ItemsSource="{Binding Sources.V8Breakpoints}" SelectedItem="{Binding Sources.SelectedBreakpoint, Mode=TwoWay}" MinHeight="40" FontSize="11" Margin="0,0,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:V8BreakpointModel">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                    <TextBlock Text="●" Foreground="#f14c4c"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Kind}" Classes="sources-meta" FontSize="9"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBox Name="txtFunctionBreakpointExpression" Text="{Binding Sources.FunctionBreakpointExpression, Mode=TwoWay}" PlaceholderText="Function expression, e.g. app.render" FontSize="10" Height="25"/>
                        <Button Name="btnAddFunctionBreakpoint" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.AddFunctionBreakpointCommand}" Content="Add function" Margin="4,0,0,0" AutomationProperties.Name="Add function breakpoint"/>
                    </Grid>
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <ComboBox Name="cmbInstrumentationBreakpoint" ItemsSource="{Binding Sources.InstrumentationBreakpoints}" SelectedItem="{Binding Sources.InstrumentationBreakpoint, Mode=TwoWay}" FontSize="10" Height="25"/>
                        <Button Name="btnAddInstrumentationBreakpoint" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.AddInstrumentationBreakpointCommand}" Content="Add event" Margin="4,0,0,0" AutomationProperties.Name="Add instrumentation breakpoint"/>
                    </Grid>
                    <ComboBox Name="cmbBreakpointKind" Grid.Row="4" ItemsSource="{Binding Sources.BreakpointKinds}" SelectedItem="{Binding Sources.BreakpointKind, Mode=TwoWay}" FontSize="10" Height="25" Margin="0,0,0,4"/>
                    <TextBox Name="txtBreakpointCondition" Grid.Row="5" Text="{Binding Sources.BreakpointCondition, Mode=TwoWay}" PlaceholderText="Condition, e.g. count &gt; 5" FontSize="10" Height="25" Margin="0,0,0,4"/>
                    <TextBox Name="txtBreakpointLogMessage" Grid.Row="6" Text="{Binding Sources.BreakpointLogMessage, Mode=TwoWay}" PlaceholderText="Log message, e.g. count = {count}" FontSize="10" Height="25" Margin="0,0,0,4"/>
                    <Grid Grid.Row="7" ColumnDefinitions="*,*,*" ColumnSpacing="3" Margin="0,0,0,4">
                        <Button Name="btnUpdateBreakpoint" Classes="sources-compact" Command="{Binding Sources.UpdateSelectedBreakpointCommand}" Content="Apply"/>
                        <Button Name="btnToggleBreakpointEnabled" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.ToggleSelectedBreakpointEnabledCommand}" Content="Toggle"/>
                        <Button Name="btnRemoveBreakpoint" Classes="sources-compact" Grid.Column="2" Command="{Binding Sources.RemoveSelectedBreakpointCommand}" Content="Remove"/>
                    </Grid>
                    <Button Name="btnToggleBreakpoint" Grid.Row="8" Classes="sources-compact" Content="Toggle breakpoint at caret · F9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>

            <Border Name="pnlDebuggerIgnoreList" Classes="sources-section" Padding="5">
                <Grid RowDefinitions="Auto,5,*">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" MinHeight="112" MaxHeight="240">
                        <Grid ColumnDefinitions="Auto,*" Margin="1,0,0,4">
                            <TextBlock Text="URL PATTERNS" Classes="sources-meta" FontSize="9" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Sources.BlackboxStatusText}" Classes="sources-meta" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox Name="lstBlackboxPatterns" Grid.Row="1" ItemsSource="{Binding Sources.BlackboxPatterns}" SelectedItem="{Binding Sources.SelectedBlackboxPattern, Mode=TwoWay}" MinHeight="32" FontSize="10" Margin="0,0,0,4"/>
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBox Name="txtNewBlackboxPattern" Text="{Binding Sources.NewBlackboxPattern, Mode=TwoWay}" PlaceholderText="URL regex, e.g. /node_modules/" FontSize="10" Height="25"/>
                            <Button Name="btnAddBlackboxPattern" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.AddBlackboxPatternCommand}" Content="Add" Margin="4,0,0,0"/>
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
                            <CheckBox Name="chkSkipAnonymousScripts" Content="Skip anonymous" IsChecked="{Binding Sources.SkipAnonymousScripts, Mode=TwoWay}" FontSize="10"/>
                            <Button Name="btnApplyBlackboxPatterns" Classes="sources-compact" Grid.Column="1" Command="{Binding Sources.ApplyBlackboxPatternsCommand}" Content="Apply"/>
                            <Button Name="btnRemoveBlackboxPattern" Classes="sources-compact" Grid.Column="2" Command="{Binding Sources.RemoveBlackboxPatternCommand}" Content="Remove" Margin="3,0,0,0"/>
                        </Grid>
                    </Grid>
                    <GridSplitter Name="splitIgnoreListSections" Grid.Row="1" Height="5" Margin="0,2" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Sources.Border}"/>
                    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" MinHeight="84">
                        <Grid ColumnDefinitions="Auto,*" Margin="1,3,0,4">
                            <TextBlock Text="EXECUTION CONTEXTS" Classes="sources-meta" FontSize="9" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Sources.ExecutionContextStatusText}" Classes="sources-meta" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox Name="lstExecutionContexts" Grid.Row="1" ItemsSource="{Binding Sources.ExecutionContexts}" SelectedItem="{Binding Sources.SelectedExecutionContext, Mode=TwoWay}" MinHeight="32" FontSize="10" Margin="0,0,0,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:V8ExecutionContextModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" Margin="1">
                                        <TextBlock Text="⊘" IsVisible="{Binding IsBlackboxed}" Foreground="{DynamicResource Brush.Sources.Accent}" FontSize="12"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Classes="sources-meta" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Name="btnToggleExecutionContextBlackboxed" Grid.Row="2" Classes="sources-compact"
                                Command="{Binding Sources.ToggleSelectedExecutionContextBlackboxedCommand}"
                                Content="Toggle selected context" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="Ignore or restore all scripts in the selected V8 execution context"
                                AutomationProperties.Name="Toggle selected execution context blackboxing"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
