<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:map="using:XamlPlayground.Editor.Minimap"
             xmlns:vm="clr-namespace:CdpInspectorApp.ViewModels"
             xmlns:tree="clr-namespace:Avalonia.Controls.DataGridHierarchical;assembly=Avalonia.Controls.DataGrid"
             xmlns:models="clr-namespace:CdpInspectorApp.Models;assembly=CDP.Inspector.Shared"
             x:Class="CdpInspectorApp.Views.SourcesView"
             x:DataType="vm:MainWindowViewModel"
             xmlns:splits="clr-namespace:CDP.Editor.Splits.Controls;assembly=CDP.Editor.Splits"
             xmlns:md="using:CDP.Markdown.Editor"
             xmlns:doc="using:CDP.Document.Editor"
             x:CompileBindings="True">
    <Grid RowDefinitions="*" Margin="10">
        <splits:SuperSplit Name="SplitControl"
                            Grid.Row="0"
                            Root="{Binding Sources.LayoutRoot}"
                            SelectedNode="{Binding Sources.SelectedPane, Mode=TwoWay}"
                            DockGroup="Sources"
                            ConstrainDockingToRoot="True"/>
        
        <Grid Name="HiddenPanel" IsVisible="False">
            <Grid Name="pnlSourcesFiles" RowDefinitions="Auto, *, Auto, 120" Margin="0,5,0,0">
                    <TextBlock Text="Workspace Navigator" Classes="panel-header" Margin="0,0,0,5"/>
                    <DataGrid Name="treeWorkspaceFiles"
                                 HierarchicalModel="{Binding Sources.HierarchicalWorkspaceFiles}"
                                 SelectedItem="{Binding Sources.SelectedFileNode, Mode=TwoWay}"
                                 HierarchicalRowsEnabled="True"
                                 GridLinesVisibility="None"
                                 HeadersVisibility="None"
                                 Background="Transparent" BorderThickness="0"
                                 CanUserResizeColumns="True"
                                 CanUserSortColumns="False"
                                 Grid.Row="1">
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridHierarchicalColumn Width="*">
                                <DataGridHierarchicalColumn.CellTemplate>
                                    <DataTemplate x:DataType="tree:HierarchicalNode">
                                        <TextBlock Text="{Binding ((models:WorkspaceFileNode)Item).Name}"/>
                                    </DataTemplate>
                                </DataGridHierarchicalColumn.CellTemplate>
                            </DataGridHierarchicalColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock Text="Structure Outline" Classes="panel-header" Grid.Row="2" Margin="0,10,0,5"/>
                    <TreeView Name="treeOutline" Grid.Row="3" Background="Transparent" BorderThickness="0"/>
                </Grid>
            <Grid Name="pnlSourcesRuntimeScripts" RowDefinitions="Auto, Auto, *" Margin="0,5,0,0">
                <TextBlock Text="V8 Runtime Scripts" Classes="panel-header" Margin="0,0,0,5"/>
                <TextBlock Name="txtV8DebuggerStatus" Grid.Row="1" Text="{Binding Sources.DebuggerStatusText}" FontSize="11" Foreground="#9aa0a6" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ListBox Name="lstRuntimeScripts" Grid.Row="2"
                         ItemsSource="{Binding Sources.RuntimeScripts}"
                         SelectedItem="{Binding Sources.SelectedRuntimeScript, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:V8ScriptModel">
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#e8eaed" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#9aa0a6" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Name="pnlSourcesSearch" RowDefinitions="Auto, Auto, Auto, *" Margin="0,5,0,0">
                    <TextBlock Text="Search in Workspace" Classes="panel-header" Margin="0,0,0,5"/>

                    <!-- Query Input and Search button -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <TextBox Name="txtSourcesSearch"
                                 Text="{Binding Sources.SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search files..."
                                 Height="28"
                                 VerticalContentAlignment="Center"/>
                        <Button Name="btnSearchWorkspace"
                                Command="{Binding Sources.SearchCommand}"
                                Grid.Column="1"
                                Content="Search"
                                Margin="5,0,0,0"
                                Padding="10,0"
                                Height="28"/>
                    </Grid>

                    <!-- Case sensitive checkbox -->
                    <CheckBox Grid.Row="2"
                              IsChecked="{Binding Sources.SearchCaseSensitive, Mode=TwoWay}"
                              Margin="0,0,0,8">
                         <TextBlock Text="Case sensitive" FontSize="12" VerticalAlignment="Center"/>
                    </CheckBox>

                    <!-- Search Results DataGrid -->
                    <DataGrid Grid.Row="3"
                              Name="dgSearchResults"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Sources.SearchResults}"
                              x:DataType="models:SearchResultModel"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              CanUserResizeColumns="True"
                              DoubleTapped="OnSearchResultDoubleTapped">
                        <DataGrid.Columns>
                            <!-- File Column -->
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding Path}"
                                                Width="120"
                                                Foreground="#8ab4f8"
                                                FontSize="11"/>
                            <!-- Line Column -->
                            <DataGridTextColumn Header="Line"
                                                Binding="{Binding LineNumber}"
                                                Width="50"
                                                Foreground="#9aa0a6"
                                                FontSize="11"/>
                            <!-- Preview Column -->
                            <DataGridTextColumn Header="Content"
                                                Binding="{Binding LineContent}"
                                                Width="*"
                                                Foreground="#e8eaed"
                                                FontSize="11"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            <!-- Code Viewer -->
            <Grid Name="pnlCodeViewer" RowDefinitions="Auto, *" Margin="10,0,10,0">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                    <TextBlock Name="lblSourceFileName" Text="{Binding Sources.SelectedFileName}" Classes="panel-header" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,5" VerticalAlignment="Center">
                        <TextBlock Name="txtLiveEditStatus" Text="{Binding Sources.LiveEditStatus}" FontSize="10" Foreground="#8ab4f8" VerticalAlignment="Center"/>
                        <ToggleButton Name="btnToggleMarkdownMode"
                                      IsVisible="{Binding Sources.IsMarkdownFile}"
                                      IsChecked="{Binding Sources.IsMarkdownPreviewMode, Mode=TwoWay}"
                                      Height="26" Padding="8,0" VerticalAlignment="Center" ToolTip.Tip="Toggle Preview / Source Mode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel>
                                    <PathIcon Data="{StaticResource EyeIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsSourceEditorVisible}"/>
                                    <PathIcon Data="{StaticResource CodeIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsMarkdownPreviewMode}"/>
                                </Panel>
                                <TextBlock Text="Preview" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Name="btnToggleDocumentMode"
                                      IsVisible="{Binding Sources.IsDocumentFile}"
                                      IsChecked="{Binding Sources.IsDocumentPreviewMode, Mode=TwoWay}"
                                      Height="26" Padding="8,0" VerticalAlignment="Center" ToolTip.Tip="Toggle Rendered / Raw Mode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel>
                                    <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12" IsVisible="{Binding Sources.IsDocumentPreviewMode}"/>
                                    <PathIcon Data="{StaticResource CodeIcon}" Width="12" Height="12" IsVisible="{Binding !Sources.IsDocumentPreviewMode}"/>
                                </Panel>
                                <TextBlock Text="Rendered" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Name="btnSaveFile" IsEnabled="{Binding Sources.CanEditCurrentSource}" ToolTip.Tip="Save file or apply V8 live edit (Ctrl+S)" Height="26" Padding="8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource SaveIcon}" Width="12" Height="12"/>
                                <TextBlock Text="Save" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Name="btnThemeSelector" ToolTip.Tip="Toggle Editor Theme" Height="26" Padding="8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource SettingsIcon}" Width="12" Height="12"/>
                                <TextBlock Text="Theme" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <map:MinimapTextEditor Name="txtSourceContent"
                                           IsVisible="{Binding Sources.IsSourceEditorVisible}"
                                           FontFamily="Consolas,Monaco,Courier New,monospace" FontSize="11" Foreground="#e8eaed" Background="Transparent" BorderThickness="0" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                           ToolTip.Tip="F9 breakpoint · F5 continue · F6 pause · F10 step over · F11 step into · Shift+F11 step out · Ctrl+S save/live edit"/>
                    <ScrollViewer IsVisible="{Binding Sources.IsMarkdownPreviewMode}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <md:MarkdownEditor Name="mdVisualEditor"
                                           Text="{Binding Sources.SelectedFileContent, Mode=TwoWay}"
                                           IsReadOnly="{Binding !Sources.IsFileSelected}"
                                           IsDarkTheme="True"
                                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                    <ScrollViewer IsVisible="{Binding Sources.IsDocumentPreviewMode}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <doc:DocumentEditor Name="docVisualEditor"
                                            FilePath="{Binding Sources.LocalPreviewFilePath}"
                                            IsReadOnly="True"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <!-- Right Debugger Panel -->
            <Border Name="pnlDebugger" BorderBrush="#3c4043" BorderThickness="1,0,0,0" Background="#292a2d" Padding="8">
                <Grid RowDefinitions="Auto, Auto, Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="V8 Debugger" Classes="panel-header"/>
                            <TextBlock Text="{Binding Sources.DebuggerStatusText}" FontSize="10" Foreground="#9aa0a6"/>
                            <TextBlock Text="{Binding Sources.PauseReason, StringFormat='Reason: {0}'}" FontSize="10" Foreground="#ffca28"/>
                        </StackPanel>
                        <ComboBox Name="cmbPauseOnExceptions" Grid.Column="1" Width="90"
                                  ItemsSource="{Binding Sources.PauseOnExceptionsStates}"
                                  SelectedItem="{Binding Sources.PauseOnExceptionsState, Mode=TwoWay}"
                                  ToolTip.Tip="Pause on exceptions"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <Button Name="btnDebuggerResume" Command="{Binding Sources.ResumeCommand}" ToolTip.Tip="Resume (Play)" Width="36" Height="30" Padding="0">
                            <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14" Foreground="#4caf50"/>
                        </Button>
                        <Button Name="btnDebuggerPause" Command="{Binding Sources.PauseCommand}" ToolTip.Tip="Pause" Width="36" Height="30" Padding="0">
                            <PathIcon Data="{StaticResource PauseIcon}" Width="14" Height="14" Foreground="#ffca28"/>
                        </Button>
                        <Button Name="btnDebuggerStepOver" Command="{Binding Sources.StepOverCommand}" ToolTip.Tip="Step Over" Width="36" Height="30" Padding="0">
                            <PathIcon Data="{StaticResource ArrowStepOverIcon}" Width="14" Height="14" Foreground="#2196f3"/>
                        </Button>
                        <Button Name="btnDebuggerStepInto" Command="{Binding Sources.StepIntoCommand}" ToolTip.Tip="Step Into" Width="36" Height="30" Padding="0">
                            <PathIcon Data="{StaticResource ArrowStepInIcon}" Width="14" Height="14" Foreground="#ffca28"/>
                        </Button>
                        <Button Name="btnDebuggerStepOut" Command="{Binding Sources.StepOutCommand}" ToolTip.Tip="Step Out" Width="36" Height="30" Padding="0">
                            <PathIcon Data="{StaticResource ArrowStepOutIcon}" Width="14" Height="14" Foreground="#e040fb"/>
                        </Button>
                        <Button Name="btnDebuggerRestartFrame" Command="{Binding Sources.RestartFrameCommand}" ToolTip.Tip="Restart selected frame" Width="36" Height="30" Padding="0" Content="↻" FontSize="18" Foreground="#8ab4f8"/>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <TextBox Name="txtDebuggerExpression" Text="{Binding Sources.DebuggerEvaluationExpression, Mode=TwoWay}"
                                 PlaceholderText="Evaluate in selected call frame" FontSize="11"/>
                        <Button Name="btnDebuggerEvaluate" Grid.Column="1" Command="{Binding Sources.EvaluateOnCallFrameCommand}" Content="Evaluate" Margin="5,0,0,0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Sources.DebuggerEvaluationResult}" FontFamily="Consolas,Monaco,Courier New,monospace" FontSize="11" Foreground="#8ab4f8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5,0,2">
                                <TextBlock Text="Watch" Classes="panel-header" FontSize="12" VerticalAlignment="Center"/>
                                <Button Name="btnRefreshWatches" Grid.Column="1" Command="{Binding Sources.RefreshWatchExpressionsCommand}" Content="Refresh" FontSize="10" Padding="6,2"/>
                                <Button Name="btnRemoveWatch" Grid.Column="2" Command="{Binding Sources.RemoveWatchExpressionCommand}" Content="Remove" FontSize="10" Padding="6,2" Margin="4,0,0,0"/>
                            </Grid>
                            <ListBox Name="lstDebuggerWatches" ItemsSource="{Binding Sources.WatchExpressions}"
                                     SelectedItem="{Binding Sources.SelectedWatchExpression, Mode=TwoWay}"
                                     MinHeight="60" MaxHeight="140" FontSize="11" Margin="0,0,0,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:V8WatchExpressionModel">
                                        <Grid ColumnDefinitions="2*,3*">
                                            <TextBlock Text="{Binding Expression}" Foreground="#8ab4f8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#e8eaed" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBox Name="txtNewWatchExpression" Text="{Binding Sources.NewWatchExpression, Mode=TwoWay}" PlaceholderText="Add watch expression" FontSize="11"/>
                                <Button Name="btnAddWatchExpression" Grid.Column="1" Command="{Binding Sources.AddWatchExpressionCommand}" Content="Add" Margin="5,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Call Stack" Classes="panel-header" FontSize="12" Margin="0,5,0,2"/>
                            <ListBox Name="lstDebuggerCallFrames" ItemsSource="{Binding Sources.CallFrames}"
                                     SelectedItem="{Binding Sources.SelectedCallFrame, Mode=TwoWay}"
                                     MinHeight="90" MaxHeight="180" FontSize="11" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:V8CallFrameModel">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Scopes" Classes="panel-header" FontSize="12" Margin="0,5,0,2"/>
                            <DataGrid Name="dgDebuggerScopes" ItemsSource="{Binding Sources.ScopeVariables}" Height="180" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent" BorderBrush="#3c4043" BorderThickness="1" FontSize="11" Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Key}" Width="140" Foreground="#8ab4f8"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" Foreground="#e8eaed"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,2">
                                <TextBlock Text="Breakpoints" Classes="panel-header" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Name="chkBreakpointsActive" Grid.Column="1" Content="Active"
                                          IsChecked="{Binding Sources.AreBreakpointsActive, Mode=TwoWay}"
                                          ToolTip.Tip="Globally activate or deactivate all breakpoints" FontSize="10"/>
                            </Grid>
                            <ListBox Name="lstV8Breakpoints" ItemsSource="{Binding Sources.V8Breakpoints}"
                                     SelectedItem="{Binding Sources.SelectedBreakpoint, Mode=TwoWay}"
                                     Height="110" FontSize="11" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:V8BreakpointModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                                            <TextBlock Text="●" Foreground="#ef5350"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Kind}" Foreground="#9aa0a6" FontSize="9"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ComboBox Name="cmbBreakpointKind" ItemsSource="{Binding Sources.BreakpointKinds}"
                                      SelectedItem="{Binding Sources.BreakpointKind, Mode=TwoWay}"
                                      FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Name="txtBreakpointCondition" Text="{Binding Sources.BreakpointCondition, Mode=TwoWay}"
                                     PlaceholderText="Condition, e.g. count &gt; 5" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Name="txtBreakpointLogMessage" Text="{Binding Sources.BreakpointLogMessage, Mode=TwoWay}"
                                     PlaceholderText="Log message, e.g. count = {count}" FontSize="11" Margin="0,0,0,5"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,0,0,8">
                                <Button Name="btnUpdateBreakpoint" Command="{Binding Sources.UpdateSelectedBreakpointCommand}"
                                        Content="Apply" FontSize="10" Padding="4"/>
                                <Button Name="btnToggleBreakpointEnabled" Grid.Column="1" Command="{Binding Sources.ToggleSelectedBreakpointEnabledCommand}"
                                        Content="Enable / Disable" FontSize="10" Padding="4"/>
                                <Button Name="btnRemoveBreakpoint" Grid.Column="2" Command="{Binding Sources.RemoveSelectedBreakpointCommand}"
                                        Content="Remove" FontSize="10" Padding="4"/>
                            </Grid>
                            <Button Name="btnToggleBreakpoint" Content="Toggle Breakpoint at Caret" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Padding="0,6"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
