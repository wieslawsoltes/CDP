<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Chrome.DevTools.Protocol</PackageId>
    <Title>Chrome.DevTools.Protocol</Title>
    <Description>Chrome DevTools Protocol (CDP) core server and session logic.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageTags>cdp;chrome-devtools-protocol;diagnostics;server;core</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Chrome.DevTools.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Automation/ITelemetryProvider.cs" />
    <Compile Remove="Automation/NetworkTelemetryProvider.cs" />
    <Compile Remove="Automation/PerformanceTelemetryProvider.cs" />
    <Compile Remove="Automation/TestStudioReportGenerator.cs" />
    <Compile Remove="Automation/TestStudioStepConverter.cs" />
    <Compile Remove="Automation/TestStudioYamlParser.cs" />
    <Compile Remove="Client/CdpService.cs" />
    <Compile Remove="Client/ICdpService.cs" />
    <Compile Remove="Client/IOsAutomation.cs" />
    <Compile Remove="Client/OSNode.cs" />
    <Compile Remove="Client/OSWindow.cs" />
    <Compile Remove="Client/OsAutomationCdpSession.cs" />
    <Compile Remove="Client/OsAutomationProvider.cs" />
    <Compile Remove="Client/ScreencastReconstructor.cs" />
    <Compile Remove="Domains/DotMemoryProfilingEngine.cs" />
    <Compile Remove="Domains/DotTraceProfilingEngine.cs" />
    <Compile Remove="Domains/EventPipeProfilingEngine.cs" />
    <Compile Remove="Domains/IProfilingEngine.cs" />
    <Compile Remove="Domains/ProfilerDomain.cs" />
    <Compile Remove="Domains/SimulatedProfilingEngine.cs" />
    <Compile Remove="Jint/CdpJintEvaluator.cs" />
    <Compile Remove="Server/TiledScreencastProducer.cs" />
  </ItemGroup>

</Project>
